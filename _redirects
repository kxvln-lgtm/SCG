# SPA routing: the app is a single index.html with client-side screen
# switching (no real server routes). Send known app paths back to the
# app shell so direct/shared links like /projects or /communities open
# the app instead of a bare Netlify 404.
/projects       /index.html   200
/communities    /index.html   200
/profile        /index.html   200
/login          /index.html   200
/register       /index.html   200
/hub            /index.html   200
/notifications  /index.html   200
/privacy        /index.html   200
/terms          /index.html   200
/faq            /index.html   200

# Anything else genuinely unmatched falls through to the styled 404 page.
/*  /404.html  404
